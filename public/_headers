# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public,max-age=3600,s-maxage=86400

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public,max-age=3600,s-maxage=86400

/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public,max-age=3600,s-maxage=86400

/devtools/*
  Cache-Control: public,max-age=3600,s-maxage=86400

/pdftools/*
  Cache-Control: public,max-age=3600,s-maxage=86400

/finance/*
  Cache-Control: public,max-age=3600,s-maxage=86400

# Trust and discovery headers. These do not replace the cache rules above.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Link: <https://toolioz.com/sitemap.xml>; rel="sitemap", <https://toolioz.com/feed.xml>; rel="alternate"; type="application/rss+xml"

# Same edge cache as finance, devtools, and pdftools, for sections that had none.
