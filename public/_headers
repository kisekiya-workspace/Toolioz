# Public images are not content-hashed. A week is enough; hashed bundles stay immutable below.
/*.svg
  Cache-Control: public,max-age=604800

/*.png
  Cache-Control: public,max-age=604800

/*.webp
  Cache-Control: public,max-age=604800

/*.jpg
  Cache-Control: public,max-age=604800

/*.jpeg
  Cache-Control: public,max-age=604800

/*.ico
  Cache-Control: public,max-age=604800

/*.woff2
  Cache-Control: public,max-age=31536000,immutable

# Must stay last so extension rules do not shorten the hashed Next.js cache.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable
